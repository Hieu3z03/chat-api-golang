APP_NAME=chat-api
GOLANG_PORT=8888

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=change_me
DB_NAME=chat_api
DB_SSLMODE=disable

MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=chat_api

# Addresses used only when the Go API runs inside Docker. For a remote
# database server, replace these values with its reachable hostname or IP.
DOCKER_DB_HOST=host.docker.internal
DOCKER_MONGO_URI=mongodb://host.docker.internal:27017

# Docker Compose host port
CENTRIFUGO_PORT=8000

# Centrifugo secrets (replace before deploying outside local development)
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=change_me_centrifugo_token_secret
CENTRIFUGO_API_KEY=change_me_centrifugo_api_key
CENTRIFUGO_ADMIN_PASSWORD=change_me_admin
CENTRIFUGO_ADMIN_SECRET=change_me_centrifugo_admin_secret
